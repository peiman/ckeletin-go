# Paths under internal/ that write directly.
# A directory named ui, progress, logger, or testutil is not exempt.
# *_test.go files are already exempt.
# Each other line is a relative path, an optional count= or lines= pin, then a reason.
# A pin fails when the file gains or loses a matching line.
# Example:
# internal/tui/screen.go count=1 full-screen TUI writes the frame
internal/ui/check.go count=1 check printer writes to stdout
internal/progress/terminal.go count=2 detects whether stdout or stderr is a terminal
internal/progress/reporter.go count=2 default progress handler writes to stderr
